<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.2-c001 63.139439, 2010/09/27-13:37:26        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:xmp="http://ns.adobe.com/xap/1.0/">
         <xmp:CreateDate>2014-02-06T08:20:33-05:00</xmp:CreateDate>
         <xmp:ModifyDate>2014-09-16T16:17:40-04:00</xmp:ModifyDate>
         <xmp:MetadataDate>2014-09-16T16:17:40-04:00</xmp:MetadataDate>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">CES 2013 Benchmark Article</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Bag>
               <rdf:li>U.S. Bureau of Labor Statistics</rdf:li>
            </rdf:Bag>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Current Employment Statistics, CES, benchmank article</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>CESâ€“National Benchmark Article</rdf:li>
               <rdf:li>BLS Establishment Survey National Estimates Revised to</rdf:li>
               <rdf:li>Incorporate March 2013 Benchmarks</rdf:li>
               <rdf:li>With the release of January 2014 data on February 7</rdf:li>
               <rdf:li>2014</rdf:li>
               <rdf:li>the Bureau of Labor Statistics (BLS) introduced its annual revision of National estimates of employment</rdf:li>
               <rdf:li>hours</rdf:li>
               <rdf:li>and earnings from the Current Employment Statistics (CES) monthly survey of nonfarm establishments. Each year</rdf:li>
               <rdf:li>the CES survey realigns its sample-based estimates to incorporate universe counts of employment</rdf:li>
               <rdf:li>a process known as benchmarking.</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/">
         <xmpMM:DocumentID>uuid:11660e9b-e451-4756-95c0-5f0512a3224c</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:415854fe-d3b9-4261-922e-68cc6aebe024</xmpMM:InstanceID>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>CESâ€“National Benchmark Article, BLS Establishment Survey National Estimates Revised to&#xD;&#xA;Incorporate March 2013 Benchmarks, With the release of January 2014 data on February 7, 2014, the Bureau of Labor Statistics (BLS) introduced its annual revision of National estimates of employment, hours, and earnings from the Current Employment Statistics (CES) monthly survey of nonfarm establishments. Each year, the CES survey realigns its sample-based estimates to incorporate universe counts of employment, a process known as benchmarking.</pdf:Keywords>
      </rdf:Description>
   </rdf:RDF>
</x:xmpmeta>
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                           
